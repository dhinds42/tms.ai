{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "legal_name": {
      "type": "string",
      "description": "Legal business name"
    },
    "org_type": {
      "type": "string",
      "enum": [
        "BROKER",
        "CARRIER",
        "OWNER_OPERATOR",
        "CUSTOMER"
      ],
      "description": "Organization type for baseline policies"
    },
    "dot_number": {
      "type": "string",
      "description": "DOT number"
    },
    "mc_number": {
      "type": "string",
      "description": "MC number"
    },
    "scac": {
      "type": "string",
      "description": "Standard Carrier Alpha Code"
    },
    "tax_id": {
      "type": "string",
      "description": "EIN/Tax ID"
    },
    "parent_org_id": {
      "type": "string",
      "description": "Parent organization for sub-orgs (optional)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation ID"
    },
    "time_zone_default": {
      "type": "string",
      "default": "America/New_York",
      "description": "Default timezone"
    },
    "country": {
      "type": "string",
      "default": "USA"
    },
    "state": {
      "type": "string"
    },
    "billing_email": {
      "type": "string",
      "format": "email"
    },
    "data_retention_policy_id": {
      "type": "string",
      "description": "Reference to DataRetentionPolicy"
    },
    "branding_settings": {
      "type": "object",
      "properties": {
        "logo_url": {
          "type": "string"
        },
        "primary_color": {
          "type": "string"
        },
        "secondary_color": {
          "type": "string"
        }
      },
      "description": "Logo, colors, etc."
    },
    "feature_flags": {
      "type": "object",
      "description": "Enabled features/modules"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}