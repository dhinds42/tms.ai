{
  "name": "Yard",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string",
      "description": "Reference to Location (facility)"
    },
    "name": {
      "type": "string",
      "description": "Yard name"
    },
    "yard_type": {
      "type": "string",
      "enum": [
        "dc_yard",
        "crossdock_yard",
        "terminal_yard",
        "port_yard",
        "rail_yard",
        "staging_yard"
      ],
      "description": "Type of yard"
    },
    "max_parking_slots": {
      "type": "number",
      "description": "Total parking capacity"
    },
    "current_occupancy": {
      "type": "number",
      "description": "Current slots occupied"
    },
    "capacity_percentage": {
      "type": "number",
      "description": "Calculated occupancy %"
    },
    "gate_hours": {
      "type": "object",
      "description": "Operating hours for yard access"
    },
    "security_requirements": {
      "type": "object",
      "description": "Security protocols"
    },
    "contact_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "location_id",
    "name",
    "yard_type"
  ]
}