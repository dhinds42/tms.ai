{
  "name": "TollTransaction",
  "type": "object",
  "properties": {
    "load_leg_id": {
      "type": "string",
      "description": "Reference to LoadLeg"
    },
    "load_id": {
      "type": "string"
    },
    "toll_location_id": {
      "type": "string",
      "description": "Reference to TollLocation"
    },
    "tractor_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "transponder_id": {
      "type": "string",
      "description": "Transponder used"
    },
    "txn_time": {
      "type": "string",
      "format": "date-time"
    },
    "amount": {
      "type": "number",
      "description": "Toll amount charged"
    },
    "toll_vendor_party_id": {
      "type": "string",
      "description": "Toll authority"
    },
    "source": {
      "type": "string",
      "enum": [
        "toll_file_feed",
        "api",
        "manual",
        "transponder_report"
      ],
      "default": "toll_file_feed"
    },
    "reference_number": {
      "type": "string",
      "description": "Transaction reference"
    },
    "vehicle_class": {
      "type": "string"
    },
    "plaza_id": {
      "type": "string"
    },
    "is_reimbursable": {
      "type": "boolean",
      "default": true,
      "description": "Can be billed to customer"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "txn_time",
    "amount"
  ]
}