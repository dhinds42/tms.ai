{
  "name": "Shipper",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        }
      }
    },
    "primary_lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          }
        }
      }
    },
    "commodities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "net_15",
        "net_30",
        "net_45",
        "net_60",
        "quick_pay"
      ],
      "default": "net_30"
    },
    "credit_limit": {
      "type": "number"
    },
    "credit_score": {
      "type": "number",
      "description": "Credit check score (0-850)"
    },
    "credit_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "requires_review"
      ],
      "default": "pending"
    },
    "credit_check_date": {
      "type": "string",
      "format": "date"
    },
    "duns_number": {
      "type": "string",
      "description": "Dun & Bradstreet number"
    },
    "tax_id": {
      "type": "string"
    },
    "total_loads": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "average_rate": {
      "type": "number"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "pending"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending_signature",
        "signed",
        "expired"
      ],
      "default": "not_started"
    },
    "contract_signed_date": {
      "type": "string",
      "format": "date"
    },
    "contract_expiration_date": {
      "type": "string",
      "format": "date"
    },
    "contract_document_url": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "company_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "enterprise"
      ]
    },
    "annual_volume": {
      "type": "number",
      "description": "Estimated annual shipping volume"
    },
    "additional_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "is_primary": {
            "type": "boolean"
          },
          "created_date": {
            "type": "string"
          }
        }
      }
    },
    "notes_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "created_date": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "scheduled_date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "created_date": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date"
    },
    "next_follow_up": {
      "type": "string",
      "format": "date"
    },
    "quickbooks_customer_id": {
      "type": "string",
      "description": "QuickBooks Customer ID for sync"
    },
    "xero_contact_id": {
      "type": "string",
      "description": "Xero Contact ID for sync"
    },
    "accounting_sync_enabled": {
      "type": "boolean",
      "default": false
    },
    "last_accounting_sync": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company_name",
    "contact_name",
    "email"
  ]
}