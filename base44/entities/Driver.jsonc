{
  "name": "Driver",
  "type": "object",
  "properties": {
    "party_id": {
      "type": "string",
      "description": "Reference to Party (employer carrier or owner-op)"
    },
    "linked_user_id": {
      "type": "string",
      "description": "For portal login"
    },
    "linked_employee_id": {
      "type": "string",
      "description": "If internal employee"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "available",
        "assigned",
        "on_load",
        "off_duty",
        "on_leave",
        "terminated",
        "suspended"
      ],
      "default": "active"
    },
    "driver_status": {
      "type": "string",
      "enum": [
        "available",
        "on_duty",
        "driving",
        "sleeper",
        "off_duty",
        "home_time",
        "suspended"
      ],
      "default": "available"
    },
    "cdl_number": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "cdl_state": {
      "type": "string"
    },
    "license_state": {
      "type": "string"
    },
    "cdl_expiration": {
      "type": "string",
      "format": "date"
    },
    "license_expiry": {
      "type": "string",
      "format": "date"
    },
    "cdl_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "endorsements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "H, N, X, T, P, S, etc."
    },
    "medical_card_expiry": {
      "type": "string",
      "format": "date"
    },
    "medical_card_expiration": {
      "type": "string",
      "format": "date"
    },
    "hos_eligibility": {
      "type": "string",
      "enum": [
        "property",
        "passenger",
        "exempt"
      ],
      "default": "property"
    },
    "preferred_language": {
      "type": "string",
      "default": "english"
    },
    "preferred_contact_channel": {
      "type": "string",
      "enum": [
        "sms",
        "app",
        "phone",
        "email"
      ],
      "default": "app",
      "description": "Preferred contact method"
    },
    "home_terminal_location_id": {
      "type": "string"
    },
    "is_owner_operator": {
      "type": "boolean",
      "default": false
    },
    "equipment_assigned": {
      "type": "string",
      "description": "Truck number or equipment ID"
    },
    "payment_structure": {
      "type": "string",
      "enum": [
        "percentage",
        "per_mile",
        "per_load",
        "hourly"
      ],
      "default": "per_load"
    },
    "payment_rate": {
      "type": "number",
      "description": "Rate amount (e.g., 75 for 75%, 500 for $500/load)"
    },
    "current_location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      }
    },
    "hos_remaining": {
      "type": "number",
      "description": "Hours of service remaining"
    },
    "hos_reset_date": {
      "type": "string",
      "format": "date-time"
    },
    "home_terminal": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "preferred_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_loads": {
      "type": "number",
      "default": 0
    },
    "on_time_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "safety_score": {
      "type": "number",
      "description": "Safety metrics score"
    },
    "performance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall performance score (auto-calculated)"
    },
    "performance_tier": {
      "type": "string",
      "enum": [
        "Elite",
        "Professional",
        "Standard",
        "Training"
      ],
      "description": "Performance tier based on metrics"
    },
    "last_score_update": {
      "type": "string",
      "format": "date-time",
      "description": "When performance score was last calculated"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "synced_to_tms_b": {
      "type": "boolean",
      "default": false,
      "description": "Whether driver data synced to TMS-B"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "tms_environment": {
      "type": "string",
      "enum": [
        "tms_a",
        "tms_b",
        "both"
      ],
      "default": "tms_a"
    },
    "portal_access_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether driver has TMS-B portal access"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone",
    "cdl_number",
    "payment_structure"
  ]
}