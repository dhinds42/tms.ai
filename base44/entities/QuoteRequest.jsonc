{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "request_number": {
      "type": "string",
      "description": "Unique RFQ number"
    },
    "request_source": {
      "type": "string",
      "enum": [
        "shipper_portal",
        "public_form",
        "rep_entry",
        "edi",
        "api",
        "email",
        "phone"
      ],
      "description": "How request came in"
    },
    "shipper_party_id": {
      "type": "string",
      "description": "Reference to Party if known, nullable for public requests"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "contact_phone": {
      "type": "string"
    },
    "origin_location_id": {
      "type": "string",
      "description": "Location ID if in system"
    },
    "origin_address_raw": {
      "type": "object",
      "description": "Raw address if not in system"
    },
    "destination_location_id": {
      "type": "string"
    },
    "destination_address_raw": {
      "type": "object",
      "description": "Raw address if not in system"
    },
    "pickup_date_requested": {
      "type": "string",
      "format": "date"
    },
    "delivery_date_requested": {
      "type": "string",
      "format": "date"
    },
    "equipment_type_requested": {
      "type": "string",
      "enum": [
        "dry_van",
        "reefer",
        "flatbed",
        "step_deck",
        "lowboy",
        "tanker",
        "container",
        "intermodal",
        "ltl",
        "other"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "truck",
        "rail",
        "ocean",
        "air",
        "intermodal",
        "drayage",
        "ltl"
      ],
      "default": "truck"
    },
    "commodity_description": {
      "type": "string"
    },
    "commodity_id": {
      "type": "string",
      "description": "Reference to Commodity if classified"
    },
    "weight_lbs": {
      "type": "number"
    },
    "volume_cu_ft": {
      "type": "number"
    },
    "pallets": {
      "type": "number"
    },
    "pieces": {
      "type": "number"
    },
    "hazmat_flag": {
      "type": "boolean",
      "default": false
    },
    "temperature_controlled": {
      "type": "boolean",
      "default": false
    },
    "temperature_requirements": {
      "type": "string"
    },
    "special_requirements": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "rated",
        "quoted",
        "accepted",
        "rejected",
        "expired",
        "cancelled"
      ],
      "default": "new"
    },
    "assigned_to_user_id": {
      "type": "string",
      "description": "Rep handling this RFQ"
    },
    "linked_quote_id": {
      "type": "string",
      "description": "Quote generated from this request"
    },
    "linked_shipment_id": {
      "type": "string",
      "description": "Shipment if booked"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "request_source"
  ]
}