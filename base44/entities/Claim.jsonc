{
  "name": "Claim",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string",
      "description": "Reference to Load"
    },
    "customer_party_id": {
      "type": "string",
      "description": "Customer filing claim"
    },
    "carrier_party_id": {
      "type": "string",
      "description": "Carrier involved"
    },
    "claim_number": {
      "type": "string",
      "description": "Unique claim identifier"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "cargo_damage",
        "shortage",
        "overage",
        "delay",
        "theft",
        "accident",
        "liability",
        "concealed_damage"
      ],
      "description": "Type of claim"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time"
    },
    "reported_date": {
      "type": "string",
      "format": "date"
    },
    "reported_by_contact_id": {
      "type": "string",
      "description": "Contact who reported"
    },
    "incident_location_id": {
      "type": "string",
      "description": "Where incident occurred"
    },
    "incident_location_raw": {
      "type": "object",
      "description": "Raw location if not in system"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of claim"
    },
    "claimed_amount": {
      "type": "number",
      "description": "Amount claimed"
    },
    "approved_amount": {
      "type": "number",
      "description": "Amount approved for settlement"
    },
    "paid_amount": {
      "type": "number",
      "description": "Amount actually paid"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "pending_docs",
        "under_review",
        "approved",
        "settled",
        "denied",
        "closed",
        "withdrawn"
      ],
      "default": "open"
    },
    "root_cause_category": {
      "type": "string",
      "enum": [
        "carrier",
        "shipper_packaging",
        "consignee",
        "weather",
        "act_of_god",
        "theft",
        "concealed",
        "unknown",
        "other"
      ],
      "description": "Root cause"
    },
    "liability_party_id": {
      "type": "string",
      "description": "Who is liable"
    },
    "policy_id": {
      "type": "string",
      "description": "Reference to InsurancePolicy"
    },
    "insurance_claim_number": {
      "type": "string",
      "description": "Insurance company claim number"
    },
    "legal_case_reference": {
      "type": "string",
      "description": "Legal case number if escalated"
    },
    "assigned_to_user_id": {
      "type": "string",
      "description": "Claims adjuster/handler"
    },
    "resolution_date": {
      "type": "string",
      "format": "date"
    },
    "resolution_notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "shipment_id",
    "claim_type",
    "incident_date",
    "reported_date"
  ]
}