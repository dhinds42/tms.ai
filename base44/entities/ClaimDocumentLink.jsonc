{
  "name": "ClaimDocumentLink",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "Reference to Claim"
    },
    "document_id": {
      "type": "string",
      "description": "Reference to Document"
    },
    "document_role": {
      "type": "string",
      "enum": [
        "photos",
        "inspection_report",
        "police_report",
        "correspondence",
        "proof_of_value",
        "repair_estimate",
        "settlement_agreement",
        "denial_letter"
      ],
      "description": "Role of document in claim"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "claim_id",
    "document_id",
    "document_role"
  ]
}