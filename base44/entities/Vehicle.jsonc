{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string",
      "description": "Reference to Load (for car transport)"
    },
    "vin": {
      "type": "string",
      "description": "Vehicle Identification Number"
    },
    "year": {
      "type": "number"
    },
    "make": {
      "type": "string",
      "description": "e.g., Ford, Toyota"
    },
    "model": {
      "type": "string",
      "description": "e.g., F-150, Camry"
    },
    "trim": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used",
        "damaged"
      ],
      "default": "used"
    },
    "operable": {
      "type": "boolean",
      "default": true,
      "description": "Running / non-running"
    },
    "pickup_location_id": {
      "type": "string",
      "description": "Dealer, auction, port, or address"
    },
    "delivery_location_id": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "picked_up",
        "in_transit",
        "delivered"
      ],
      "default": "pending"
    },
    "rate_per_vehicle": {
      "type": "number",
      "description": "Rate charged for this specific vehicle"
    },
    "inspection_notes": {
      "type": "string",
      "description": "Pre-trip condition notes"
    },
    "damage_notes": {
      "type": "string",
      "description": "Post-trip damage if any"
    },
    "lot_number": {
      "type": "string",
      "description": "Auction lot # if applicable"
    },
    "buyer_number": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "shipment_id",
    "vin"
  ]
}