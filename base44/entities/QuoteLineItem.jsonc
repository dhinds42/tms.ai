{
  "name": "QuoteLineItem",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "Reference to Quote"
    },
    "line_number": {
      "type": "number",
      "description": "Line sequence number"
    },
    "line_type": {
      "type": "string",
      "enum": [
        "linehaul",
        "fuel_surcharge",
        "accessorial",
        "tax",
        "fee",
        "discount"
      ],
      "description": "Type of charge"
    },
    "description": {
      "type": "string",
      "description": "Customer-facing description"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity (miles, cwt, containers, etc.)"
    },
    "unit_type": {
      "type": "string",
      "description": "Unit of measure (mi, cwt, container, etc.)"
    },
    "rate_cents": {
      "type": "number",
      "description": "Rate per unit in cents"
    },
    "amount_cents": {
      "type": "number",
      "description": "Total line amount in cents"
    },
    "is_taxable": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "quote_id",
    "line_type",
    "description",
    "amount_cents"
  ]
}